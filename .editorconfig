# EditorConfig — https://editorconfig.org
# Cohérence de formatage entre éditeurs. Godot suit l'indentation par TABULATIONS.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript : indentation par tabulations (convention officielle Godot)
[*.gd]
indent_style = tab
indent_size = 4

# Fichiers de scènes/ressources Godot
[*.{tscn,tres,godot,import,cfg}]
indent_style = tab

# Markdown / YAML : espaces
[*.{md,yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
